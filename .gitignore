# Logs / temporary files
# =========================
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo

# =========================
# OS / IDE
# =========================
.DS_Store
Thumbs.db
.idea/
.vscode/

# =========================
# Local archives / exports
# =========================
*.zip
*.tar
*.tar.gz
*.7z

